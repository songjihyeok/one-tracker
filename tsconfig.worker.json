{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["./worker-configuration.d.ts", "node"]
  },
  "include": ["worker", "server/store.ts", "shared/data.ts", "shared/types.ts", "tests/worker.test.ts"]
}
